# Copy to .env and fill in. Never commit .env.

# development or production
ENVIRONMENT=development

POSTGRES_USER=interviewace
# Required: choose a strong password
POSTGRES_PASSWORD=
POSTGRES_DB=interviewace

# Required (32+ chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173

# Optional first admin account (created once, on startup)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Used from phase 3 (mock interviews). Server-side only.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
